# Weekly SEO Fix Kit production D1 backup: wrangler d1 export (approved exception
# until cf ships D1 export, cloudflare/cf#199), then upload to R2 bucket
# seofixkit-backups under d1/. Replaces the Mac scheduled task
# seofixkit-weekly-d1-backup (retired 2026-10-18 when the Mac was wiped).
# This pair lives next to ops/backup-d1.sh since fleet-ops#10145 moved it out of
# the loose ~/.config/systemd/user copy; ops/README.md has the install line, the
# off switch and the current status.
# Runs ops/backup-d1.sh from a dedicated clean clone (not the dirty proof-seo checkout).
# Credentials: EnvironmentFile holds CLOUDFLARE_API_TOKEN (and optionally
# CLOUDFLARE_ACCOUNT_ID), needs D1 Read + Workers R2 Storage Write. Never in argv.
# governed-run no longer exists on this host (archived 2026-09-07), so the unit
# bounds itself with Nice/MemoryMax/TimeoutStartSec.
# Failure is loud: OnFailure= fires the healthchecks.io fail ping.
[Unit]
Description=SEO Fix Kit weekly production D1 backup to R2
After=network-online.target
Wants=network-online.target
OnFailure=fleet-unit-failed@%N.service

[Service]
Type=oneshot
WorkingDirectory=%h/workspaces/products/seo-fix-kit
EnvironmentFile=%h/.config/cloudflare/seofixkit-backup.env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=CI=1
Environment=npm_config_yes=true
ExecStart=/usr/bin/bash %h/workspaces/products/seo-fix-kit/ops/backup-d1.sh
TimeoutStartSec=900
Nice=10
MemoryMax=2G
UMask=0077
