{
  "name": "seo-fix-kit",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "npm run build && npm run db:migrate:local && concurrently -k -n worker,web \"npm run dev:worker\" \"npm run dev:web\"",
    "dev:worker": "wrangler dev --local --ip 127.0.0.1 --port 8787",
    "dev:web": "vite --host 127.0.0.1 --port 5173",
    "dev:cf": "wrangler dev --remote",
    "db:migrate:local": "wrangler d1 migrations apply WAITLIST_DB --local",
    "start": "npm run build && npm run db:migrate:local && npm run dev:worker",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test:e2e": "npm run build && playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cf:dry-run": "cf deploy --dry-run",
    "audit:live-promise": "node test/live-promise-spot-check.mjs",
    "audit:public-check-walk": "node test/public-check-walk.mjs",
    "test:billing": "node server/dodo-payment-smoke-test.js",
    "test:billing-route": "node --test worker/routes/billing.test.mjs",
    "test:product-truth": "node server/product-truth-smoke-test.js",
    "test:audit": "node server/audit/smoke-test.js",
    "test:large-crawl-security": "node server/large-crawl-security-smoke-test.js",
    "test:report-retention-security": "node server/report-retention-security-smoke-test.js",
    "test:worker-dispatch": "node --import ./test/cloudflare-workers-hooks.mjs --test worker/index.test.mjs",
    "test:worker-email": "node --test worker/lib/email.test.mjs",
    "test:d1-retry": "node --test worker/lib/d1-retry.test.mjs",
    "test:scheduled-d1-load": "node --import ./test/cloudflare-workers-hooks.mjs --test test/scheduled-d1-load.test.mjs",
    "test:bounded": "node --test test/bounded.test.mjs",
    "test:public-pages": "node --import ./test/cloudflare-workers-hooks.mjs --test worker/routes/pages.test.mjs",
    "test:public-check": "node --test worker/routes/public-check.test.mjs",
    "test:free-tools": "node --test shared/free-tools/free-tools.test.mjs",
    "test:status": "node --import ./test/cloudflare-workers-hooks.mjs --test worker/routes/status.test.mjs",
