    "test:indexnow": "node --test test/submit-index-now.test.mjs",
    "submit:indexnow": "node server/submit-index-now.js",
    "sitemap:refresh": "node --import ./test/cloudflare-workers-hooks.mjs server/refresh-sitemap-lastmods.js",
    "test:check-inventory": "node --test test/check-chain-inventory.test.mjs",
    "test:d1-backup-workflow": "node --import ./test/cloudflare-workers-hooks.mjs --test worker/d1-backup-workflow.test.mjs",
    "check": "npm run test:billing && npm run test:billing-route && npm run test:product-truth && npm run test:audit && npm run test:large-crawl-security && npm run test:report-retention-security && npm run test:worker-dispatch && npm run test:d1-backup-workflow && npm run test:worker-email && npm run test:d1-retry && npm run test:scheduled-d1-load && npm run test:bounded && npm run test:public-pages && npm run test:public-check && npm run test:free-tools && npm run test:status && npm run test:audit-engine && npm run test:offers && npm run test:account && npm run test:ai-answer-readiness && npm run test:growth-opportunities && npm run test:repair-queue && npm run test:repair-proof-receipt && npm run test:repair-implementation-pack && npm run test:repair-agent && npm run test:developer-api && npm run test:remediation-brief && npm run test:webhooks && npm run test:validation && npm run test:access-events && npm run test:access && npm run test:app-contract && npm run test:api-client && npm run test:storage && npm run test:promise-audit && npm run test:live-promise-spot-check && npm run test:public-check-walk && npm run test:funnel-walk && npm run test:large-crawl && npm run test:indexnow && npm run test:check-inventory && npm run test:d1-support && npm run test:auth-flow && npm run test:account-deletion && npm run test:payments-flow && npm run test:core-api-flow && npm run test:slack-alerts && npm run test:audit-emails && npm run test:uptime && npm run test:site-progress && npm run test:ai-fix-prompt && npm run test:site-verification && npm run test:score-history && npm run test:score-badges && npm run test:fix-kit && npm run test:audit-widget && npm run test:client-report && npm run test:activation-emails && npm run test:spa && npm run build && npm run test:budget",
    "audit:funnel-walk": "node test/private-beta-funnel-walk.mjs",
    "test:funnel-walk": "node --test test/private-beta-funnel-walk.test.mjs",
    "test:api-client": "node --test src/api.test.mjs",
    "test:storage": "node --test src/storage.test.mjs",
    "test:d1-support": "node --test test/support/d1.test.mjs",
    "test:auth-flow": "node --import ./test/cloudflare-workers-hooks.mjs --test test/auth-flow.test.mjs",
    "test:account-deletion": "node --import ./test/cloudflare-workers-hooks.mjs --test test/account-deletion-flow.test.mjs",
    "test:payments-flow": "node --import ./test/cloudflare-workers-hooks.mjs --test test/payments-flow.test.mjs",
    "test:core-api-flow": "node --import ./test/cloudflare-workers-hooks.mjs --test test/core-api-flow.test.mjs",
    "test:spa": "node --test test/spa.test.mjs",
    "test:budget": "node --test test/budget.test.mjs",
    "tour:capture": "node e2e/capture-tour.mjs",
    "test:client-report": "node --import ./test/cloudflare-workers-hooks.mjs --test test/client-report-flow.test.mjs"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.1.0",
    "@tanstack/react-query": "^5.104.2",
    "cookie": "^1.1.1",
    "hono": "^4.13.13",
    "playwright": "^1.57.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router": "^7.18.4",
    "robots-parser": "^3.0.1",
    "standardwebhooks": "^1.1.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.7",
    "@eslint/js": "^9.39.5",
    "@fontsource-variable/inter": "^5.3.0",
    "@playwright/test": "^1.60.0",
    "@vitejs/plugin-react": "^5.1.0",
    "cf": "1.0.0-beta.25",
    "concurrently": "10.0.6",
    "esbuild": "0.28.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
