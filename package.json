    "test:growth-opportunities": "node --test shared/growth-opportunities.test.mjs",
    "test:repair-queue": "node --test shared/repair-queue.test.mjs",
    "test:repair-proof-receipt": "node --test shared/repair-proof-receipt.test.mjs",
    "test:repair-implementation-pack": "node --test shared/repair-implementation-pack.test.mjs",
    "test:repair-agent": "node --test worker/routes/repair-agent.test.mjs",
    "test:developer-api": "node --test worker/routes/developer-api.test.mjs",
    "test:remediation-brief": "node server/remediation-brief-smoke-test.js",
    "test:webhooks": "node --test worker/lib/webhooks.test.mjs",
    "test:validation": "node --test worker/lib/validation.test.mjs",
