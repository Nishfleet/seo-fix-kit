    "test:audit-emails": "node --import ./test/cloudflare-workers-hooks.mjs --test test/audit-emails-flow.test.mjs",
    "test:uptime": "node --test test/uptime-flow.test.mjs",
    "test:site-progress": "node --test shared/site-progress.test.mjs",
    "test:ai-fix-prompt": "node --test shared/ai-fix-prompt.test.mjs",
    "test:site-verification": "node --import ./test/cloudflare-workers-hooks.mjs --test test/site-verification-flow.test.mjs",
    "test:score-history": "node --import ./test/cloudflare-workers-hooks.mjs --test test/score-history-flow.test.mjs",
    "test:score-badges": "node --import ./test/cloudflare-workers-hooks.mjs --test test/score-badges-flow.test.mjs",
    "test:fix-kit": "node --import ./test/cloudflare-workers-hooks.mjs --test test/fix-kit-flow.test.mjs",
