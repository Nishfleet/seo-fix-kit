{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "module": "es2022",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["@cloudflare/workers-types"]
  },
  "include": [
    "shared/dodo.js",
    "shared/email-layout.js",
    "shared/fix-patterns.js",
    "shared/html.js",
    "shared/offers.js",
    "shared/url-safety.js",
    "worker/lib/bounded.js",
    "worker/lib/d1-retry.js",
    "worker/lib/http.js",
    "worker/lib/offers.js",
    "worker/lib/paid-features.js",
    "worker/lib/security.js",
    "worker/lib/slack.js",
    "worker/lib/validation.js",
    "worker/env.d.ts"
  ],
  "exclude": ["**/*.test.mjs", "**/*.test.js"]
}
